# ============================================
# NextShip Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control


# ============================================
# App Configuration
# ============================================
# Application name displayed in browser title and meta tags
NEXT_PUBLIC_APP_NAME=NextShip

# Base URL of your application (used for canonical URLs and redirects)
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# URL to API documentation (if available)
NEXT_PUBLIC_API_DOC_URL=https://api.yourdomain.com/docs


# ============================================
# Legal & Company Information
# ============================================
# Copyright text displayed in footer
NEXT_PUBLIC_COPYRIGHT=NextShip Inc.

# Privacy policy page URL
NEXT_PUBLIC_PRIVACY_POLICY=/privacy-policy

# Service agreement/Terms of service page URL
NEXT_PUBLIC_SERVICE_AGREEMENT=/service-agreement


# ============================================
# API Configuration
# ============================================
# Base URL for API requests
# Use relative path (/) for same-origin API
# Use full URL (https://api.yourdomain.com) for cross-origin API
NEXT_PUBLIC_API_BASE_URL=/api

# API request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT=30000


# ============================================
# Authentication
# ============================================
# Key used to store authentication token in localStorage
NEXT_PUBLIC_TOKEN_KEY=token


# ============================================
# File Upload Configuration
# ============================================
# Allowed image file extensions
NEXT_PUBLIC_UPLOAD_IMAGE_ACCEPT=.png,.jpg,.jpeg,.webp

# Allowed file extensions for general uploads
NEXT_PUBLIC_UPLOAD_FILE_ACCEPT=.png,.jpg,.jpeg,.pdf,.doc,.docx

# Allowed video file extensions
NEXT_PUBLIC_UPLOAD_VIDEO_ACCEPT=.mp4,.webm,.mov

# Maximum file size in bytes (default: 10MB = 10485760 bytes)
NEXT_PUBLIC_UPLOAD_MAX_FILE_SIZE=10485760


# ============================================
# Analytics & Tracking
# ============================================
# Google Tag Manager ID (GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Google Analytics Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=


# ============================================
# Error Tracking (Optional)
# ============================================
# Sentry DSN for error tracking
# NEXT_PUBLIC_SENTRY_DSN=


# ============================================
# Database (Server-side only)
# ============================================
# These variables are NOT exposed to the client
# DATABASE_URL=postgresql://user:password@localhost:5432/nextship


# ============================================
# Email (Server-side only)
# ============================================
# SMTP configuration for sending emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourdomain.com


# ============================================
# Storage (Server-side only)
# ============================================
# AWS S3 or compatible storage configuration
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=


# ============================================
# Third-party Services (Server-side only)
# ============================================
# OAuth providers
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Payment providers
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=


# ============================================
# Development Only
# ============================================
# These should not be used in production
# NEXT_PUBLIC_ENABLE_DEBUG=false
