# ============================================
# NextShip Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control


# ============================================
# App Configuration
# ============================================
# Application name displayed in browser title and meta tags
NEXT_PUBLIC_APP_NAME=NextShip

# Base URL of your application (used for canonical URLs and redirects)
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# URL to API documentation (if available)
NEXT_PUBLIC_API_DOC_URL=https://api.yourdomain.com/docs


# ============================================
# Legal & Company Information
# ============================================
# Copyright text displayed in footer
NEXT_PUBLIC_COPYRIGHT='NextShip Inc.'

# Privacy policy page URL
NEXT_PUBLIC_PRIVACY_POLICY=/privacy-policy

# Service agreement/Terms of service page URL
NEXT_PUBLIC_SERVICE_AGREEMENT=/service-agreement

# GitHub repository URL
NEXT_PUBLIC_GITHUB_URL=https://github.com/yourusername/yourrepo


# ============================================
# API Configuration
# ============================================
# Base URL for API requests (use / for same-origin, or full URL for cross-origin)
NEXT_PUBLIC_API_BASE_URL=/api

# API request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT=30000

# Key used to store authentication token in localStorage
NEXT_PUBLIC_TOKEN_KEY=token


# ============================================
# Internationalization (i18n)
# ============================================
# Default locale for the application (e.g., en, zh)
NEXT_PUBLIC_LOCALE_DEFAULT=en

# Cookie key name for storing user's locale preference
NEXT_PUBLIC_LOCALE_COOKIE_KEY=NEXT_LOCALE


# ============================================
# File Upload Configuration
# ============================================
# Allowed image file extensions
NEXT_PUBLIC_UPLOAD_IMAGE_ACCEPT=.png,.jpg,.jpeg,.webp

# Allowed file extensions for general uploads
NEXT_PUBLIC_UPLOAD_FILE_ACCEPT=.png,.jpg,.jpeg,.pdf,.doc,.docx

# Allowed video file extensions
NEXT_PUBLIC_UPLOAD_VIDEO_ACCEPT=.mp4,.webm,.mov

# Maximum file size in bytes (10MB = 10485760 bytes)
NEXT_PUBLIC_UPLOAD_MAX_FILE_SIZE=10485760


# ============================================
# Analytics & Tracking
# ============================================
# Google Tag Manager ID (GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Google Analytics Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=
